{
  "name": "visualizer",
  "productName": "Visualizer",
  "private": true,
  "version": "0.1.0",
  "description": "Sound-reactive rave visualizer: CRT-synthesis grit meets generative geometry. WebGL2 + Web Audio + WebCodecs.",
  "author": "Visualizer",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "desktop": "npm run build && node tools/build-desktop.mjs && electron .",
    "desktop:dev": "node tools/desktop-dev.mjs",
    "ffmpeg": "node tools/prepare-ffmpeg.mjs",
    "dist": "node tools/dist.mjs"
  },
  "dependencies": {
    "mediabunny": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/ws": "^8.18.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.2",
    "ws": "^8.22.0"
  }
}
